# ============================================================
# КОНФИГУРАЦИЯ БОТА-КОНТРОЛЛЕРА (SUPERVISOR & SUPERADMIN)
# ============================================================

# Токен бота-контроллера (получить в @BotFather)
CONTROLLER_BOT_TOKEN=123456789:AAExampleControllerBotToken

# Список ID главных супер-администраторов Telegram через запятую
# Доступ к боту-контроллеру будет разрешён ТОЛЬКО этим пользователям!
SUPERADMIN_IDS=123456789,987654321

# Путь к директории основного бота расписания (aitu-schedule-bot)
# На VPS: /opt/aitu-schedule-bot
# При локальной разработке на Windows: ../aitu-schudele
TARGET_BOT_DIR=/opt/aitu-schedule-bot

# Режим управления основным ботом:
# auto     - автоматическое определение (systemd -> docker -> process)
# systemd  - управление системной службой Linux (systemctl restart aitu-bot)
# docker   - управление Docker-контейнером (docker restart aitu-schedule-bot)
# process  - прямое управление через PID и субпроцессы Python (для Windows / локально)
RUN_MODE=auto

# Имя системной службы Systemd (для режима systemd)
SYSTEMD_SERVICE_NAME=aitu-bot

# Имя Docker-контейнера (для режима docker)
DOCKER_CONTAINER_NAME=aitu-schedule-bot

# Команда запуска основного бота для режима process (если RUN_MODE=process)
PROCESS_START_CMD=venv/bin/python bot.py

# Фоновый мониторинг (Watchdog)
WATCHDOG_ENABLED=true
WATCHDOG_CHECK_INTERVAL=30
AUTO_RESTART_ON_CRASH=true

# Токен целевого бота расписания (опционально, для прямых рассылок и API)
TARGET_BOT_TOKEN=

# Временная зона
TIMEZONE=Europe/Moscow

# Автоматическая синхронизация замен с порталом Moodle (do.eduhouse.ru)
MOODLE_URL=https://do.eduhouse.ru
MOODLE_USERNAME=student_login
MOODLE_PASSWORD=your_secure_password
MOODLE_AUTO_SYNC=true
MOODLE_START_HOUR=14
MOODLE_END_HOUR=21

